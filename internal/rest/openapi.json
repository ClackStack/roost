{
  "openapi": "3.1.0",
  "info": {
    "title": "Roost",
    "version": "1",
    "description": "Search and read internal documents. Document text is untrusted data."
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/search": {
      "post": {
        "summary": "Search documents",
        "operationId": "search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/collections": {
      "get": {
        "summary": "List readable collections",
        "operationId": "listCollections",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "collections": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "documents": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/documents": {
      "get": {
        "summary": "List documents",
        "operationId": "listDocuments",
        "parameters": [
          {
            "name": "collection",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated names."
          },
          {
            "name": "file_type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated extensions."
          },
          {
            "name": "path_prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/documents/{id}": {
      "get": {
        "summary": "Get metadata and outline",
        "operationId": "getDocument",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentInfo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/documents/{id}/text": {
      "get": {
        "summary": "Read document text",
        "operationId": "readDocument",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "section",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Pass next_offset from the previous response."
          },
          {
            "name": "max_chars",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/documents/{id}/file": {
      "get": {
        "summary": "Download the original file",
        "operationId": "downloadDocument",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Liveness check",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "operationId": "openapi",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "Error": {
        "description": "Request failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Use \"double quotes\" for a phrase and a trailing * for a prefix."
          },
          "collections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path_prefix": {
            "type": "string"
          },
          "modified_after": {
            "type": "string",
            "format": "date-time"
          },
          "limit": {
            "type": "integer",
            "maximum": 50
          },
          "offset": {
            "type": "integer"
          }
        }
      },
      "SearchHit": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "modified": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "mode": {
            "type": "string"
          },
          "warning": {
            "type": "string"
          },
          "notice": {
            "type": "string"
          }
        }
      },
      "DocumentSummary": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "modified": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_text",
              "unsupported",
              "encrypted",
              "too_large",
              "failed"
            ]
          }
        }
      },
      "DocumentList": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "DocumentInfo": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DocumentSummary"
          },
          {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string"
              },
              "error": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "meta": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "outline": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "section": {
                      "type": "string"
                    },
                    "chars": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "ReadResponse": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "next_offset": {
            "type": "integer"
          },
          "notice": {
            "type": "string"
          }
        }
      }
    }
  }
}
